# Variables del entorno Docker (NO es el .env de Laravel).
# Docker Compose lee este archivo automáticamente.

DB_PASSWORD=inventarios

# Igualan el usuario del contenedor al tuyo para que los archivos que escribe
# Laravel en storage/ no queden con dueño root.
#
# Linux y macOS: averiguá los tuyos con `id -u` e `id -g`.
# Windows con Docker Desktop: dejá 1000/1000, no aplica.
UID=1000
GID=1000
