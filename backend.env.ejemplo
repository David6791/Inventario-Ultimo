# Este SÍ es el .env de Laravel. Va en backend/.env

APP_NAME="Sistema de Inventarios"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:4200

# ATENCIÓN: el host es "db", el nombre del servicio en docker-compose.
# Si ponés 127.0.0.1 el contenedor se busca a sí mismo y falla la conexión.
# El puerto es 5432 (interno), no 5433 (el que se expone al host).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=inventarios
DB_USERNAME=inventarios
DB_PASSWORD=inventarios

ADMIN_PASSWORD=Cambiar2026

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stack
LOG_LEVEL=debug
