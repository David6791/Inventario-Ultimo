APP_NAME="Sistema de Inventarios"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origen del frontend Angular. Lo consume config/cors.php.
FRONTEND_URL=http://localhost:4200

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=inventarios
DB_USERNAME=postgres
DB_PASSWORD=

# Contraseña inicial del super-admin. El sistema obliga a cambiarla al ingresar.
# Si se omite, el seeder usa "Cambiar2026".
ADMIN_PASSWORD=

# En producción use redis o database. Con "array" el caché de permisos se pierde
# entre requests y cada verificación pega a la base de datos.
CACHE_STORE=database

SESSION_DRIVER=database
QUEUE_CONNECTION=database
