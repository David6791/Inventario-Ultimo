# =============================================================================
# Configuración del despliegue
#
# Copiar como `.env` en la carpeta despliegue/ y completar.
# Este archivo NO debe subirse a un repositorio.
# =============================================================================

APP_NAME="Sistema de Inventarios"

# Generar con:
#   docker compose -f docker-compose.prod.yml run --rm api php artisan key:generate --show
APP_KEY=PWLsDrkwInHoqg+fOkPLT/Jz5K18lpv889i2nBnqBII=

# --- Según dónde se despliegue ----------------------------------------------
#
# Red local:   APP_URL=http://192.168.1.50      DOMINIO=192.168.1.50
# Con dominio: APP_URL=https://inventarios.ejemplo.bo
#              DOMINIO=inventarios.ejemplo.bo
#
# La IP tiene que ser la del servidor en la red, NO 127.0.0.1: los demás
# equipos no llegan a tu localhost.
APP_URL=http://192.168.1.14
DOMINIO=192.168.1.14
SESSION_DOMAIN=

PUERTO_HTTP=80

# --- Base de datos ----------------------------------------------------------
DB_DATABASE=inventarios
DB_USERNAME=inventarios
# Cambiar. Generar una larga con:
#   openssl rand -base64 24
DB_PASSWORD=BHGjdJQC2MMPZdQz6eY2nxjBOdbcAeNI
