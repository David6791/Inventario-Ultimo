# Copiar a .env dentro de docker-activos/ y ajustar.

# Puertos del host. Cambiar si alguno ya está ocupado.
PUERTO_WEB=8080
PUERTO_DB=5433
PUERTO_ADMINER=8081

# Base de datos de la demo. NO apuntar a la base de producción.
DB_DATABASE=activos_demo
DB_USERNAME=activos
DB_PASSWORD=activos_demo_2026

# Dejar APP_DEBUG en false al compartir en red: el trace de Laravel
# expone rutas, variables de entorno y credenciales.
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080

# El entrypoint corre migrate y seed en el primer arranque.
MIGRAR_AL_INICIAR=true
SEMBRAR_AL_INICIAR=true
