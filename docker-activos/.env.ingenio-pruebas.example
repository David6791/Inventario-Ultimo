# Copiar a .env.ingenio-pruebas (NO se sube a git) y completar.
#   copy .env.ingenio-pruebas.example .env.ingenio-pruebas

# Dirección con que se entra a la réplica (sin barra al final). Para probar
# desde el celular, la IP de esta PC en la red de la oficina.
URL_PRUEBAS=http://192.168.1.10:8091

# Base de la réplica: credenciales nuevas, solo para las pruebas.
DB_DATABASE=ingenio_pruebas
DB_USERNAME=ingenio_pruebas
DB_PASSWORD=cambiar-esta-clave

# Base de producción que se copia (la de ingenio-db): nombre y usuario,
# los mismos DB_DATABASE y DB_USERNAME de .env.ingenio. La clave no hace
# falta: la copia se hace dentro del contenedor.
ORIGEN_DB_DATABASE=
ORIGEN_DB_USERNAME=

# Puertos en esta PC (distintos de los de ingenio: 8090 y 8082). Si Docker
# dice «forbidden by its access permissions», Windows tiene reservado ese
# puerto: elija otro fuera de los rangos que muestra
#   netsh interface ipv4 show excludedportrange protocol=tcp
PUERTO_WEB=8091
PUERTO_ADMINER=8083

# Lector de boletas con Claude (opcional). La clave se crea en
# console.anthropic.com → API Keys; queda solo en el servidor, nunca llega al
# navegador. Sin clave, la recepción ofrece solo «Manual» y «Lector Tesseract».
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-sonnet-5-5
