# Copiar a .env.ingenio (NO se sube a git) y completar.
#   copy .env.ingenio.example .env.ingenio

# Dirección pública del sistema (Cloudflare). Sin barra al final.
URL_PUBLICA=https://sistema.ingeniocasiano.com

# Token del túnel: Cloudflare → Zero Trust → Networks → Tunnels → el túnel → token.
TUNNEL_TOKEN=

# Volumen de la base actual (docker volume ls). Normalmente activos-pruebas_pgdata.
VOLUMEN_DB=activos-pruebas_pgdata

# Las MISMAS credenciales con que se creó esa base (copiarlas de .env.pruebas).
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Puertos en esta PC. La base y Adminer solo escuchan en 127.0.0.1.
PUERTO_WEB=8090
PUERTO_DB=5435
PUERTO_ADMINER=8082
